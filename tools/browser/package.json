{
  "name": "@forge/tools-browser",
  "version": "0.3.0",
  "description": "Drive a real browser when a page will not yield to a fetch: navigate, read, click and type, under an isolation story written down rather than assumed.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepublishOnly": "node ../../scripts/publish-guard.mjs"
  },
  "peerDependencies": {
    "@forge/agentkit": "^0.3.0"
  },
  "devDependencies": {
    "@forge/agentkit": "*",
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "@forge/tools-scrape": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "author": "Rise Experts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rise-Experts/Forge.git",
    "directory": "tools/browser"
  },
  "homepage": "https://github.com/Rise-Experts/Forge#readme",
  "bugs": {
    "url": "https://github.com/Rise-Experts/Forge/issues"
  }
}